# LLM Provider: "openai", "ollama", or "koboldcpp"
AGENT_LLM_PROVIDER=ollama

# OpenAI (when AGENT_LLM_PROVIDER=openai)
AGENT_OPENAI_API_KEY=sk-...
AGENT_OPENAI_BASE_URL=
AGENT_DEFAULT_MODEL=gpt-4o
AGENT_FAST_MODEL=gpt-4o-mini
AGENT_REASONING_MODEL=o3

# Ollama (when AGENT_LLM_PROVIDER=ollama)
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_OLLAMA_MODEL=gemma4:e2b

# KoboldCpp (when AGENT_LLM_PROVIDER=koboldcpp)
AGENT_KOBOLDCPP_BASE_URL=http://localhost:5001
AGENT_KOBOLDCPP_MODEL=koboldcpp

# MariaDB (text-to-SQL tool) — always read-only
AGENT_MARIADB_HOST=
AGENT_MARIADB_PORT=3306
AGENT_MARIADB_USER=
AGENT_MARIADB_PASSWORD=
AGENT_MARIADB_DATABASE=
AGENT_MARIADB_MAX_ROWS=100
AGENT_MARIADB_QUERY_TIMEOUT=15

# General
AGENT_MAX_TOKENS=8192
AGENT_DATA_DIR=~/.agent
AGENT_PERMISSION_MODE=auto
