# LLM Provider: "openai" or "ollama"
AGENT_LLM_PROVIDER=ollama

# OpenAI (when AGENT_LLM_PROVIDER=openai)
AGENT_OPENAI_API_KEY=sk-...
AGENT_OPENAI_BASE_URL=
AGENT_DEFAULT_MODEL=gpt-4o
AGENT_FAST_MODEL=gpt-4o-mini
AGENT_REASONING_MODEL=o3

# Ollama (when AGENT_LLM_PROVIDER=ollama)
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_OLLAMA_MODEL=gemma4:e2b

# General
AGENT_MAX_TOKENS=8192
AGENT_DATA_DIR=~/.agent
AGENT_PERMISSION_MODE=auto
